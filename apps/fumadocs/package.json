{
  "name": "fumadocs",
  "version": "0.0.5",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "bun run scripts/stop-stale-next-dev.ts && PORTLESS_PORT=1355 portless run --name domain-sdk --force next dev",
    "start": "next start",
    "check-types": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@opencoredev/domain-sdk": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.2.0",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.8",
    "gsap": "^3.15.0",
    "next": "16.4.1",
    "posthog-js": "^1.438.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.73.0",
    "portless": "^0.15.12",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
