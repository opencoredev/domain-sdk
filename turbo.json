{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".vercel/output/**"],
      "env": ["VERCEL_PROJECT_PRODUCTION_URL", "PUBLIC_POSTHOG_KEY", "NEXT_PUBLIC_POSTHOG_KEY"]
    },
    "@domain-sdk/docs#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["VERCEL_PROJECT_PRODUCTION_URL", "PUBLIC_POSTHOG_KEY", "NEXT_PUBLIC_POSTHOG_KEY"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
