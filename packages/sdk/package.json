{
  "name": "@opencoredev/domain-sdk",
  "version": "0.3.0",
  "description": "Add, verify, monitor, and remove customer domains with one TypeScript API.",
  "keywords": [
    "bunny",
    "cloudflare",
    "custom-domains",
    "dns",
    "namecheap",
    "netlify",
    "porkbun",
    "railway",
    "render",
    "spaceship",
    "typescript",
    "vercel"
  ],
  "homepage": "https://domain-sdk.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencoredev/domain-sdk.git",
    "directory": "packages/sdk"
  },
  "bin": {
    "domain-sdk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vercel": {
      "types": "./dist/providers/vercel/index.d.ts",
      "import": "./dist/providers/vercel/index.js",
      "default": "./dist/providers/vercel/index.js"
    },
    "./cloudflare": {
      "types": "./dist/providers/cloudflare/index.d.ts",
      "import": "./dist/providers/cloudflare/index.js",
      "default": "./dist/providers/cloudflare/index.js"
    },
    "./railway": {
      "types": "./dist/providers/railway/index.d.ts",
      "import": "./dist/providers/railway/index.js",
      "default": "./dist/providers/railway/index.js"
    },
    "./render": {
      "types": "./dist/providers/render/index.d.ts",
      "import": "./dist/providers/render/index.js",
      "default": "./dist/providers/render/index.js"
    },
    "./netlify": {
      "types": "./dist/providers/netlify/index.d.ts",
      "import": "./dist/providers/netlify/index.js",
      "default": "./dist/providers/netlify/index.js"
    },
    "./bunny": {
      "types": "./dist/providers/bunny/index.d.ts",
      "import": "./dist/providers/bunny/index.js",
      "default": "./dist/providers/bunny/index.js"
    },
    "./porkbun": {
      "types": "./dist/providers/porkbun/index.d.ts",
      "import": "./dist/providers/porkbun/index.js",
      "default": "./dist/providers/porkbun/index.js"
    },
    "./namecheap": {
      "types": "./dist/providers/namecheap/index.d.ts",
      "import": "./dist/providers/namecheap/index.js",
      "default": "./dist/providers/namecheap/index.js"
    },
    "./spaceship": {
      "types": "./dist/providers/spaceship/index.d.ts",
      "import": "./dist/providers/spaceship/index.js",
      "default": "./dist/providers/spaceship/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts src/providers/vercel/index.ts src/providers/cloudflare/index.ts src/providers/railway/index.ts src/providers/render/index.ts src/providers/netlify/index.ts src/providers/bunny/index.ts src/providers/porkbun/index.ts src/providers/namecheap/index.ts src/providers/spaceship/index.ts src/testing/index.ts src/cli.ts --root src --outdir dist --target node --format esm --sourcemap=external --splitting --entry-naming '[dir]/[name].[ext]'",
    "build:types": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src test",
    "test": "bun test"
  },
  "dependencies": {
    "tldts": "^7.5.4"
  },
  "devDependencies": {
    "@domain-sdk/config": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
